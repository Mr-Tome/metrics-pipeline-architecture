# Pinned versions for one release bundle. This file is the single source of truth.
#
# Change a version here, run ./01-check-latest.sh to confirm it exists upstream,
# then commit this file. Every pull script reads it.
#
# Checked against upstream on 2026-11-09 (GitHub releases, registries, NVIDIA's GPU Operator 26.7
# component matrix). Rule: the newest stable release, except a line that is days old and still getting
# hotfixes (then the last patch of the previous line), noted below. Re-run ./01-check-latest.sh before
# every pull; anything older than about two months needs a reason written next to it.

RELEASE_NAME="si-phase1"
ARCH="amd64"

# Kubernetes
# v1.37: Traefik is the ingress controller. ingress-nginx is retired upstream (March 2026) and RKE2
# removed it in v1.37. Kubernetes 1.37 is in the GPU Operator 26.7 support range (1.33 to 1.37).
RKE2_VERSION="v1.37.2+rke2r1"

# Air-gap packaging
ZARF_VERSION="v0.89.0"

# NVIDIA
GPU_OPERATOR_VERSION="v26.7.2"
# Host driver, installed from the .run file when the lab requires a host install
# instead of the operator's driver container. Leave empty to skip the download.
# R580 is NVIDIA's long-term support branch (end of life June 2028), listed for GPU Operator 26.7.2, and runs
# CUDA 13.0 (the vLLM image) natively. Not 595 (production branch, end of life March 2027) or 615 (short-lived
# new feature branch).
# PLAN (decided 2026-11-11): deliver R620, the next long-term branch (end of life September 2029; 620.70.06
# shipped 2026-11-04). Switch both pins together as soon as a GPU Operator release lists R620 for Rocky 9 and
# the RTX PRO 6000. On 2026-11-11 the newest GPU Operator is still v26.7.2 (GitHub, NGC Helm index, release
# notes), and nvcr.io has no 620 driver image yet. Until then this stays on R580.
NVIDIA_DRIVER_VERSION="580.196.07"

# SI services
# v0.33.0 has an image but no release notes yet (rc3 on 2026-11-02); v0.32.0 is the latest release. CUDA 13.0.
VLLM_IMAGE="docker.io/vllm/vllm-openai:v0.32.0"
# The LTS line (1.108.x). LiteLLM's published chart stopped at 1.89.2; it still takes the same values keys.
LITELLM_IMAGE="ghcr.io/berriai/litellm:v1.108.4-lts"
LITELLM_CHART_VERSION="1.89.2"
# 0.12.5 is the last patch of the 0.12 line. 0.13.0 came out 2026-11-03 and had three hotfixes on 2026-11-08.
OPEN_WEBUI_IMAGE="ghcr.io/open-webui/open-webui:v0.12.5"
OPEN_WEBUI_CHART_VERSION="17.5.0"
# speaches has had no stable release since 0.8.3 (2025-09-19). See docs/12, section 10.
WHISPER_IMAGE="ghcr.io/speaches-ai/speaches:0.8.3-cuda"
# Document search embeddings for chat-page uploads, on CPU (no GPU to spare; also runs in the rehearsal VM).
EMBED_IMAGE="ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.4"
# Text extraction and OCR for uploads. 3.3.3.0 is the newest 3.x; Tika 4.2.0 is the current major (docs/12, section 10).
TIKA_IMAGE="docker.io/apache/tika:3.3.3.0-full"

# Database (gateway logs, document search with pgvector)
CNPG_CHART_VERSION="0.29.1"
# PostgreSQL 18 on Debian 13. A new install starts on the newest major (supported to 2030).
POSTGRES_IMAGE="ghcr.io/cloudnative-pg/postgresql:18.6-standard-trixie"

# Scanner and vulnerability database
TRIVY_VERSION="0.76.2"

# Client-side tools (Jupyter AI, VS Code extension). Package pins are in client-requirements.txt.
# Analysts run Python 3.9 and newer on Windows and Linux, many through Anaconda (docs/07, L3). Wheels are
# pulled for each version. Add a new Python here when it ships: a version whose packages have no wheels yet
# gets the OpenAI client only, and clients/RESOLVED.txt says so.
CLIENT_PYTHON_VERSIONS="3.9 3.10 3.11 3.12 3.13 3.14 3.15"
CONTINUE_VSCODE_VERSION="2.1.0"

# Storage for the first install (RKE2 has no default storage class).
# Loaded as image tarballs so it works before any registry exists.
LOCAL_PATH_VERSION="v0.0.37"
BUSYBOX_IMAGE="docker.io/library/busybox:1.38.0"
