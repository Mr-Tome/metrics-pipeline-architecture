# Pins for the staging add-on (staging/build-addon.sh). The add-on lets the request path run on VMs with no
# GPU. It is built and deployed separately and never sealed into the lab bundle, so nothing here is on the
# list sent to the ISSM. Checked against upstream on 2026-11-22.

# The vLLM CPU build of the same version as the lab's vLLM_IMAGE (v0.32.0).
VLLM_CPU_IMAGE="docker.io/vllm/vllm-openai-cpu:v0.32.0-x86_64"
# The CPU build of the same speaches version as the lab's WHISPER_IMAGE.
WHISPER_CPU_IMAGE="ghcr.io/speaches-ai/speaches:0.8.3-cpu"

# Stand-in language model, served under the name gpt-oss-120b so the gateway and chat page settings are the
# same as the lab's. IBM (USA), Apache 2.0, safetensors, 2B parameters, a plain transformer that vLLM runs on
# CPU. (Granite 4.0's small models are hybrid Mamba models; CPU support for those is not something to depend
# on here.)
STANDIN_REPO="ibm-granite/granite-3.3-2b-instruct"
STANDIN_COMMIT="707f574c62054322f6b5b04b6d075f0a8f05e0f0"
